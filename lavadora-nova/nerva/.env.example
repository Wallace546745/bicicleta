# Chave da Nerva (painel > Integrações > API Keys). NUNCA no frontend.
NERVA_API_KEY=sk_live_sua_chave_aqui
# Signing secret do webhook (painel > Webhooks)
NERVA_WEBHOOK_SECRET=whsec_seu_secret_aqui
# URL pública deste servidor (usada como postbackUrl). Precisa ser https.
PUBLIC_URL=https://api.suaoferta.com.br
# Domínio da loja que pode chamar este backend
ALLOWED_ORIGIN=https://suaoferta.com.br
NERVA_BASE_URL=https://pixnerva.com.br/api
PORT=3000

# Painel admin — token de acesso (invente uma senha forte)
ADMIN_TOKEN=a535c8680bc32347c4ec8320
DATA_DIR=./data

# Rastreamento TikTok próprio (Events API). O token NUNCA vai para o front.
TIKTOK_PIXEL_ID=D451RVBC77U1GG09RAKG
TIKTOK_ACCESS_TOKEN=
# Só durante a validação no Events Manager (Test Events). Depois, apague.
TIKTOK_TEST_EVENT_CODE=
# Deixe vazio. Se "1", a Nerva também dispara CompletePayment (contaria 2x).
NERVA_SEND_TRACKING=
